<div id="<%= dom_id dendro %>">
  <p>
    <strong>Sample:</strong>
    <%= dendro.sample_id %>
  </p>

  <p>
    <strong>Series code:</strong>
    <%= dendro.series_code %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= dendro.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= dendro.description %>
  </p>

  <p>
    <strong>Dating status:</strong>
    <%= dendro_dating_status(dendro) %>
  </p>
  <p>
    <strong>Measurements:</strong>
    <%= dendro.measurements %>
  </p>

</div>
