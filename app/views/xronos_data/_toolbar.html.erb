<div class="d-flex">

  <h1 class="h5 my-0 me-3 px-3 py-2 text-primary fw-bold">
    <%= bs_icon "hourglass-split" %>
    Data browser
  </h1>

  <button class="me-3 btn btn btn-outline-primary"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#dataFilters"
          aria-expanded="true"
          aria-controls="dataFilters">
    <%= bs_icon "filter" %>
    Filters
    <span class="collapse-status-open"><%= bs_icon "chevron-left" %></span>
    <span class="collapse-status-closed"><%= bs_icon "chevron-right" %></span>
  </button>

  <div class="px-3 py-2 text-muted">
    View:
  </div>
  <ul class="me-3 nav nav-pills" role="tablist">
    <li class="nav-item" role="presentation">
      <a id="dataMapTab"
         class="nav-link active"
         data-bs-toggle="pill"
         href="#dataMap"
         role="tab"
         aria-controls="dataMap"
         aria-selected="true">
        <%= bs_icon "pin-map-fill" %>
        Sites
      </a>
    </li>
    <% if @pagy %>
    <li class="nav-item" role="presentation">
      <a id="dataTableTab"
         class="nav-link"
         data-bs-toggle="pill"
         href="#dataTable"
         role="tab"
         aria-controls="dataTable"
         aria-selected="false">
        <%= bs_icon "table" %>
        Radiocarbon dates
      </a>
    </li>
    <% end %>
    <% if @dendro_pagy %>
      <li class="nav-item" role="presentation">
        <a id="dendroTableTab" class="nav-link" data-bs-toggle="pill" href="#dendroTable"
           role="tab" aria-controls="dendroTable" aria-selected="false">
          <%= bs_icon "table" %>
          Dendrochronological series
        </a>
      </li>
    <% end %>
  </ul>

  <span class="navbar-text me-3">
    <%= render "filter_status" %>
  </span>

  <ul class="nav">
  <!--
    <li class="nav-item dropdown">
      <a class="nav-link dropdown-toggle"
         id="dataTools"
         role="button"
         data-bs-toggle="dropdown"
         aria-expanded="false" href="#">
        <%= bs_icon "clipboard-data-fill" %>
        Analyse
      </a>
      <ul class="dropdown-menu" aria-labelledby="dataTools">
        <li><a class="dropdown-item" href="#">Calibrate</a></li>
        <li><a class="dropdown-item" href="#">Sum calibrate</a></li>
      </ul>
    </li>
  -->
    <li class="nav-item dropdown">
      <a class="nav-link dropdown-toggle"
         id="dataDownload"
         role="button"
         data-bs-toggle="dropdown"
         aria-expanded="false"
         href="#">
        <%= bs_icon "download" %>
        Download
      </a>
      <ul class="dropdown-menu" aria-labelledby="dataDownload" style="padding:0px;">
        <% if @pagy %>
          <li><h6 class="dropdown-header">Radiocarbon dates</h6></li>
        <li>
			<div class="d-grid gap-2">

			<%= link_to data_path(format: :csv, filter: @raw_filter_params),
				class: "nav-link",
				title: "CSV",
				download: "data_#{Date.today}.csv" do %>
					<%=bs_icon("filetype-csv")%> CSV
			<% end %>
		</div>
	  </li>
        <li>
			<div class="d-grid gap-2">

			<%= link_to data_path(format: :json, filter: @raw_filter_params),
				class: "nav-link",
				title: "JSON",
				download: "data_#{Date.today}.json" do %>
					<%=bs_icon("filetype-json")%> JSON
			<% end%>
		</div>
	  </li>
        <li>
          <div class="d-grid gap-2">
            <%= link_to data_path(format: :json, schema: C14::MIAARD::SCHEMA, filter: @raw_filter_params),
                        class: "nav-link",
                        title: "MIaaRD JSON",
                        download: "data_miaard_#{Date.today}.json" do %>
              <%= bs_icon("filetype-json") %> MIaaRD JSON
            <% end %>
          </div>
        </li>
        <% end %>
        <% if @dendro_pagy %>
          <li><h6 class="dropdown-header">Dendrochronological series</h6></li>
          <li><%= link_to "CSV", data_path(format: :csv, filter: @raw_filter_params, type: :dendro), class: "nav-link" %></li>
          <li><%= link_to "JSON", data_path(format: :json, filter: @raw_filter_params, type: :dendro), class: "nav-link" %></li>
        <% end %>
      </ul>
    </li>
  </ul>
</div>
