      multiple: true,
      data: {
        controller: "tom-select",
        "tom-select-route-value": "references/search",
        "tom-select-search-mode": "true",
        "tom-select-value-value": "short_ref",
        "tom-select-label-value": "short_ref",
        "tom-select-search-value": "short_ref"
      }
    %>

  <% end %>
<% end %>

<% end %>
