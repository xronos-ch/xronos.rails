<div class="data-browser-map w-100"
     role="region"
     aria-label="Archaeological site map"
     data-controller="map"
     data-map-target="container"
     data-map-carto-api-key-value="<%= ENV["CARTO_API_KEY"] %>"
     data-map-markers-url-value="<%= request.original_url %>">
     <div class="spinner-border position-absolute top-50 start-50 translate-middle d-none"
          style="z-index: 800"
          role="status"
          data-map-target="spinner">
       <span class="visually-hidden">Loading...</span>
     </div>
</div>
