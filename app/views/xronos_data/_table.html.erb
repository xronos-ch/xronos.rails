<%= turbo_frame_tag "data_table" do %>
  <div class="table-responsive" tabindex="0" role="region" aria-label="Radiocarbon dates">
    <table class="table compact-record-table">
      <thead>
        <tr>
          <th scope="col">
            <span class="d-md-none">Record</span>
            <span class="d-none d-md-inline">Lab ID</span>
          </th>
          <th scope="col" class="d-none d-md-table-cell">Site</th>
          <th scope="col" class="d-none d-md-table-cell">Material</th>
          <th scope="col" class="d-none d-md-table-cell">Taxon</th>
          <th scope="col" class="compact-record-table-secondary">
            <span class="d-md-none">Age</span>
            <span class="d-none d-md-inline text-nowrap">Age (BP)</span>
          </th>
          <th scope="col" class="d-none d-md-table-cell text-nowrap">Age (cal BP)</th>
        </tr>
      </thead>

      <tbody>
        <% calibrations = C14.calibrations_for(@xrons) %>
        <% @xrons.each do |x| %>
          <% calibration = calibrations.fetch(x) %>
          <% site_link = x.site ? link_to(x.site.name, x.site, target: :_top) : na_value %>
          <% material = x.sample&.material&.name || na_value %>
          <% taxon = x.sample&.taxon&.name || na_value %>
          <% calibrated_age = "#{calibration.taq}-#{calibration.tpq}" %>
          <tr>
            <td>
              <%= x.lab_identifier.present? ? link_to(x.lab_identifier, x, target: :_top) : na_value %>
              <div class="d-md-none">
                <div><%= site_link %></div>
                <div class="small text-body-secondary mt-1">Material: <%= material %></div>
                <div class="small text-body-secondary">Taxon: <%= taxon %></div>
              </div>
            </td>
            <td class="d-none d-md-table-cell"><%= site_link %></td>
            <td class="d-none d-md-table-cell"><%= material %></td>
            <td class="d-none d-md-table-cell"><%= taxon %></td>
            <td>
              <div class="d-md-none small text-body-secondary">BP</div>
              <%= x.bp %>±<%= x.std %>
              <div class="d-md-none mt-1">
                <div class="small text-body-secondary">cal BP</div>
                <%= calibrated_age %>
              </div>
            </td>
            <td class="d-none d-md-table-cell"><%= calibrated_age %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== @pagy.series_nav(:bootstrap) %>
<% end %>
