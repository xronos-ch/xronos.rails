<span class="text-muted">
  <% case event %>
  <% when "create" %>
    <%= create_icon title: "Create" %>
  <% when "update" %>
    <%= edit_icon title: "Update" %>
  <% when "supersede" %>
    <%= supersede_icon title: "Supersede" %>
  <% when "restore" %>
    <%= restore_icon title: "Restore" %>
  <% end %>
</span>
