<% entries = local_assigns[:versions] || (item.present? ? combined_changelog(item) : []) %>

<ol class="timeline">
  <% entries.reverse_each do |entry| %>
    <% is_supersession = entry.is_a?(SupersessionEvent) %>
    <li class="timeline-item" id="version-<%= is_supersession ? "se" : "v" %><%= entry.id %>">
      <span class="timeline-marker"></span>
      <div class="timeline-body">
        <div class="d-flex align-items-baseline gap-2 small">
          <%= render "application/paper_trail/event", event: is_supersession ? entry.event_type : entry.event %>
          <span class="font-monospace text-body-secondary">
            <%= entry.created_at.strftime("%F %H:%M") %>
          </span>
          <%= render "application/paper_trail/whodunnit", entry: entry %>
        </div>
        <% if is_supersession %>
          <details class="timeline-changes" open>
            <summary title="Show/hide changes">
              <%= entry.event_type == "supersede" ? "Superseded by #{entry.superseded_by.label}" : "Restored" %>
            </summary>
            <%= render "application/paper_trail/changes", entry: entry %>
          </details>
        <% elsif entry.event == "create" %>
          <div class="small">
            <%= entry.revision_comment.blank? ? "Updated." : md(entry.revision_comment) %>
          </div>
        <% elsif entry.changeset.any? { |c| c.first != "updated_at" } || (entry.snapshot_id.present? && version_peripheral_diff(entry).present?) %>
          <details class="timeline-changes">
            <summary title="Show/hide changes">
              <%= entry.revision_comment.blank? ? "Updated." : md(entry.revision_comment) %>
            </summary>
            <%= render "application/paper_trail/changes", entry: entry %>
          </details>
        <% else %>
          <div class="small">
            <%= entry.revision_comment.blank? ? "Updated." : md(entry.revision_comment) %>
          </div>
        <% end %>
      </div>
    </li>
  <% end %>
</ol>
