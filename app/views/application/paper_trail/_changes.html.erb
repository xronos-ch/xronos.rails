<% if entry.respond_to?(:changeset) %>
  <% entry.changeset.each do |change| %>
    <% unless change.first == "updated_at" %>
      <div class="d-flex">
        <dt><%= change.first.humanize %>:</dt>
        <dd class="flex-grow-1 ms-3">
          <%= change.second.first.present? ? change.second.first : na_value %>
          &rarr;
          <%= change.second.second.present? ? change.second.second : na_value %>
        </dd>
      </div>
    <% end %>
  <% end %>
<% elsif entry.event_type == "supersede" %>
  <div class="d-flex">
    <dt>Superseded by:</dt>
    <dd class="flex-grow-1 ms-3">
      <%= link_to entry.superseded_by.label, entry.superseded_by %>
    </dd>
  </div>
  <% if entry.comment.present? %>
    <div class="d-flex">
      <dt>Comment:</dt>
      <dd class="flex-grow-1 ms-3"><%= entry.comment %></dd>
    </div>
  <% end %>
<% elsif entry.event_type == "restore" %>
  <p>Restored</p>
<% end %>
