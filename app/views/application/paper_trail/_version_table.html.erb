<table class="table table-hover">

  <thead>
    <tr>
      <th><span class="visually-hidden">Toggle changes</span></th>
      <th>Time</th>
      <th>User</th>
      <th>Record</th>
      <th>Summary</th>
    </tr>

    <% versions.each do |entry| %>
      <% is_supersession = entry.is_a?(SupersessionEvent) %>
      <% prefix = is_supersession ? "se" : "v" %>
      <tbody>
        <tr>
          <td>
            <button class="btn btn-sm btn-info"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#changeset<%= prefix %><%= entry.id %>"
                    aria-expanded="false"
                    aria-controls="changeset<%= prefix %><%= entry.id %>">
                    <%= bs_icon "caret-right", title: "Show/hide changes" %>
            </button>
          </td>
          <td><%= entry.created_at %></td>
          <td><%= render "application/paper_trail/whodunnit", entry: entry %></td>
          <td>
            <% if is_supersession %>
              <%= entry.superseded_type %>:<%= entry.superseded_id %>
            <% else %>
              <%= entry.item_type %>:<%= entry.item_id %>
            <% end %>
          </td>
          <td>
            <%= render "application/paper_trail/event", event: is_supersession ? entry.event_type : entry.event %>
            <% if is_supersession %>
              <%= entry.event_type == "supersede" ? "Superseded by #{entry.superseded_by.label}" : "Restored" %>
            <% elsif entry.revision_comment.blank? %>
              <span class="text-muted">No summary</span>
            <% else %>
              <%= md(entry.revision_comment) %>
            <% end %>
          </td>
        </tr>
        <tr class="collapse" id="changeset<%= prefix %><%= entry.id %>">
          <td></td>
          <td colspan=6><%= render "application/paper_trail/changes", entry: entry %></td>
        </tr>
      </tbody>
    <% end %>

</table>
