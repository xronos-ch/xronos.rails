<% context = f.object.context %>
<% if action_name == "new" && context.name.blank? %>
  <% context = context.site.contexts.find_by(name: nil) || context %>
<% end %>
<% contexts = context.site.contexts.order(:name) %>
<% selected = context.persisted? && context.name.present? ? context.id.to_s : "" %>
<% options = [["<NA>", ""]] + contexts.filter_map { |item| [item.name, item.id.to_s] if item.name.present? } %>
<% context_data = contexts.to_h do |item|
  [item.name.present? ? item.id.to_s : "", {
    startTime: item.approx_start_time,
    endTime: item.approx_end_time,
    editable: can?(:update, item)
  }]
end %>
<% context_data[""] ||= { startTime: nil, endTime: nil, editable: true } %>
<% if context.new_record? && context.name.present? %>
  <% selected = "new:#{context.name}" %>
  <% options << [context.name, selected] %>
<% end %>

<div data-controller="context-choice" data-context-choice-contexts-value="<%= context_data.to_json %>">
  <%= f.hidden_field :context_id, value: selected.start_with?("new:") ? "" : selected,
    data: { context_choice_target: "contextId" } %>
  <%= label_tag "c14_context_choice", "Context", class: "visually-hidden" %>
  <%= select_tag "context_choice", options_for_select(options, selected),
    id: "c14_context_choice", class: "form-select mb-3", data: { context_choice_target: "select" } %>
  <%= f.fields_for :context, context, include_id: false do |ff| %>
    <%= ff.hidden_field :site_id %>
    <%= ff.hidden_field :name, data: { context_choice_target: "name" } %>
    <div class="row">
      <div class="col"><%= ff.number_field :approx_start_time, label: "Dated from", prepend: "c.", append: "cal BP",
        readonly: context.persisted? && cannot?(:update, context), data: { context_choice_target: "startTime" } %></div>
      <div class="col"><%= ff.number_field :approx_end_time, label: "Dated to", prepend: "c.", append: "cal BP",
        readonly: context.persisted? && cannot?(:update, context), data: { context_choice_target: "endTime" } %></div>
    </div>
  <% end %>
</div>
