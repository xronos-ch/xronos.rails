<li class="mb-2">
  <%= link_to "#{measurement.lab_identifier.presence || 'Measurement'} · C14 ##{measurement.id}",
              measurement, target: "_blank", rel: "noopener" %>
  <% if measurement.bp && measurement.std %>
    <span class="text-body-secondary">· <%= measurement.bp %> ± <%= measurement.std %> BP</span>
  <% end %>
  <% if (context = measurement.context) %>
    <div>
      <%= link_to context.name.presence || "Unnamed context ##{context.id}", context,
                  target: "_blank", rel: "noopener" %>
    </div>
  <% end %>
  <% if measurement.references.any? %>
    <div class="small">
      <% measurement.references.each do |reference| %>
        <%= link_to reference.short_ref, reference, target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  <% end %>
</li>
