<% content_for :title, "Issues – Sites" %>
<% if params[:issue] == "missing_country_code" %>
  <% content_for :help do %>
    <%= render "issues/sites/missing_country_code/help" %>
  <% end %>
<% end %>

<h2 class="border-bottom">Sites</h2>

<%= render "issues/nav", model: Site, base_path: issues_sites_path %>

<turbo-frame id="issues-sites-table">

  <%= render "issues/filter_form" %>

  <% if params[:issue] == "coordinates_in_water" %>
    <% if @water_check_report %>
      <p class="text-muted">Last water check <%= time_tag(@water_check_report.fetch(:checked_at), format: :short) %></p>
    <% else %>
      <p class="text-muted">Water check results are not available. Run the water check to refresh this list.</p>
    <% end %>
  <% end %>

  <%=
    case params[:issue]
    when "missing_country_code"
      render "issues/sites/missing_country_code/table", sites: @sites 
    else
      render "table", sites: @sites
    end
  %>

  <%== @pagy.series_nav(:bootstrap) %>

</turbo-frame>
