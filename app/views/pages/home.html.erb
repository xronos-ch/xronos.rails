<%= content_for :head do %>
  <!-- News feeds -->
  <%= tag.link rel: "alternate", type: "application/atom+xml", href: news_url(format: :atom) %>
  <%= tag.link rel: "alternate", type: "application/rss+xml", href: news_url(format: :rss) %>
<% end %>
<%= content_for :og_title, "XRONOS: Open chronometric data for archaeology" %>

<div class="hero d-flex mt-0 position-relative py-5 shadow">

  <div class="container d-flex flex-column" style="text-shadow: var(--bs-dark) 0 0 1rem;">
    <h1 class="mt-auto mb-4 mb-lg-5 display-5 fw-bold">Open chronometric data for archaeology</h1>
    <div class="me-lg-auto mb-auto">
      <%= render "searches/form" %>
    </div>
  </div>

  <span class="hero_caption position-absolute bottom-0 end-0"><small>Photo: <a class="link-light" href="https://unsplash.com/@sahinsezerdincer?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Şahin Sezer Dinçer</a> on <a class="link-light" href="https://unsplash.com/s/photos/hourglass?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a></small></span>

</div>


<section class="py-4 py-sm-5">
  <div class="container">
    <h2 class="visually-hidden">What is XRONOS?</h2>
    <div class="row g-3 g-lg-4 align-items-center">
      <div class="col-md">
        <%= link_to data_path, class: "position-relative d-inline-block link-primary link-offset-2 link-underline-opacity-0 link-underline-opacity-100-hover" do %>
          <%= image_tag "xronos_mapviz.webp", width: 640, height: 320, class: "d-block img-fluid",
                        alt: "Map showing the density of chronometric records in XRONOS" %>
          <span class="position-absolute bottom-0 end-0 d-inline-flex align-items-center gap-2 px-2 py-1 bg-body bg-opacity-75 small fw-semibold">
            Explore the map <%= bs_icon "arrow-right" %>
          </span>
        <% end %>
      </div>
      <div class="col-md">
        <p class="lead">XRONOS is an open data infrastructure for the backbone of the archaeological record – chronology. It provides open access to published radiocarbon dates and other chronometric data from any period, anywhere in the world.</p>
        <ul class="nav">
          <li class="nav-item"><a class="nav-link ps-0 me-3" href="/about">Learn more</a></li>
          <li class="nav-item"><a class="nav-link" href="/about/contribute">Get involved</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="py-4 py-sm-5 bg-primary text-light shadow">
  <div class="container text-center">
    <div class="row row-cols-2 row-cols-lg-4 gy-4">
      <% [
        [Site, sites_path, cached_site_count],
        [C14, c14s_path, cached_c14_count],
        [Typo, typos_path, cached_typo_count]
      ].each do |model, path, count| %>
        <div class="col">
          <%= link_to path, class: "d-inline-block link-light link-underline-opacity-0 link-underline-opacity-100-hover" do %>
            <%= xr_icon model, { light: true }, { class: "home-data-icon d-block mx-auto mb-2", alt: "" } %>
            <span class="h5 d-block mb-1"><%= model.label.humanize.pluralize %></span>
            <span class="display-6 text-secondary"><%= number_with_delimiter(count) %></span>
          <% end %>
        </div>
      <% end %>

      <div class="col">
        <%= embedded_svg "icons/dendro.svg", class: "home-data-icon d-block mx-auto mb-2" %>
        <span class="h5 d-block mb-1">Dendro dates</span>
        <span class="text-warning small">Coming soon!</span>
      </div>
    </div>
  </div>
</section>

<% if @news.present? %>
  <section class="py-5">
    <div class="container">
      <div class="row">
        <div class="col col-lg-9 mx-auto">
          <h2 class="display-5 mb-4">Latest news</h2>

          <% @news.each do |article| %>
            <%= render "articles/card", article: article %>
          <% end %>

          <a href="/news" class="btn btn-lg btn-info">More news</a>
        </div>
      </div>

    </div>
  </section>
<% end %>
