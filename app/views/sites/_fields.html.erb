<section class="my-3">
  <h2 class="h5">Site names</h2>
  <div data-controller="site-name-check"
       data-site-name-check-search-url-value="<%= site_name_suggestions_path(format: :json) %>"
       data-site-name-check-site-id-value="<%= @site.id %>">
    <%= f.text_field :name,
      label: "Preferred name",
      help: "Use the most common name for the site in recent scientific literature",
      data: {
        site_name_check_target: "nameField",
        action: "input->site-name-check#queue"
      } %>
    <div class="small mt-2" aria-live="polite" data-site-name-check-target="message"></div>
  </div>
</section>

<%= f.coordinate_fields :lat, :lng,
  country_attribute: :country_code,
  country_suggestion_url: country_suggestions_path(format: :json),
  map_api_key: ENV["CARTO_API_KEY"] %>

