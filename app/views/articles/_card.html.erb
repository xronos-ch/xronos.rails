<article class="card mb-5 border-0 rounded-0">
  <% if article.splash.present? %>
    <a href="/<%= article.path %>">
      <picture>
        <source type="image/webp" srcset="<%= url_for(article.splash.variant(:card_webp)) %>">
        <img class="card-img-top rounded-0" style="height: 10rem; object-fit: none;" src="<%= url_for(article.splash.variant(:card)) %>" />
      </picture>
    </a>
  <% end %>
  <div class="card-body">
    <h1 class="h3 card-title">
      <a href="/<%= article.path %>" class="text-reset text-decoration-none"><%= article.title %></a>
    </h1>
    <p class="card-text">
      <% paragraphs = Nokogiri::HTML5.fragment(article.body_html).css("p") %>
      <% if paragraphs.any? %>
        <%= sanitize(paragraphs.first.inner_html) %>
        <% if paragraphs.many? %>
          <a class="text-muted" href="/<%= article.path %>">Read more...</a>
        <% end %>
      <% end %>
    </p>
  </div>
  <div class="card-footer d-flex bg-transparent border-0 text-muted">
    <div class="me-3">
      <%= bs_icon "calendar" %>
      <% if article.draft? %>
        draft
      <% else %>
        <% published_date = article.published_at.to_date %>
        <%= time_tag published_date, published_date.to_formatted_s %>
      <% end %>
    </div>
    <div>
      <%= bs_icon "person-circle" %>
      <%= render article.user %>
    </div>
  </div>
</article>
