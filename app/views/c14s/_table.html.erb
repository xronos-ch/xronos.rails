<% show_site = controller_name != "sites" %>
<% can_manage = can?(:manage, C14) %>
<%= render "table_sort_options", table: :c14s,
           columns: { lab_identifier: "Lab ID", method: "Method", bp: "Uncalibrated age" } %>

<div class="table-responsive" tabindex="0" role="region" aria-label="Radiocarbon dates">
  <table class="table table-hover align-middle compact-record-table">
    <thead>
      <tr>
        <% if show_site %>
          <th scope="col" class="d-none d-md-table-cell">Site</th>
        <% end %>
        <th scope="col">
          <span class="d-md-none">Record</span>
          <span class="d-none d-md-inline">
            <%= link_to_order_by "Lab ID", :lab_identifier, :c14s %>
            <% if ordered_by?(:lab_identifier, :c14s) %>
              <span class="text-muted"><%= order_indicator :c14s %></span>
            <% end %>
          </span>
        </th>
        <th scope="col" class="d-none d-md-table-cell">Context</th>
        <th scope="col" class="d-none d-md-table-cell">Material</th>
        <th scope="col" class="d-none d-md-table-cell">Taxon</th>
        <th scope="col" class="d-none d-md-table-cell">
          <%= link_to_order_by "Method", :method, :c14s %>
          <% if ordered_by?(:method, :c14s) %>
            <span class="text-muted"><%= order_indicator :c14s %></span>
          <% end %>
        </th>
        <th scope="col" class="compact-record-table-secondary text-md-end">
          <span class="d-md-none">Age</span>
          <span class="d-none d-md-inline">
            <%= link_to_order_by "Uncalibrated age", :bp, :c14s %>
            <% if ordered_by?(:bp, :c14s) %>
              <span class="text-muted"><%= order_indicator :c14s %></span>
            <% end %>
          </span>
        </th>
        <th scope="col" class="d-none d-md-table-cell text-end">Calibrated age</th>
        <th scope="col" class="d-none d-md-table-cell text-end">References</th>
        <% if can_manage %>
          <th scope="col" class="d-none d-md-table-cell text-end"><!-- Actions --></th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% calibrations = C14.calibrations_for(c14s) %>
      <% c14s.each do |c14| %>
        <% site_link = link_to(c14.site.name, c14.site, target: :_top) if show_site %>
        <% context_name = c14.sample.context.name %>
        <% material = c14.sample.material&.name || na_value %>
        <% taxon = render "taxons/taxon_abbreviated", taxon: c14.sample.taxon %>
        <% method = c14.method.presence || na_value %>
        <% uncalibrated_age = c14.uncal_age || na_value %>
        <% range = calibrations.fetch(c14)&.range %>
        <% calibrated_age = range ? "#{range.join("–")} cal BP" : na_value %>
        <% references = render "references/citations", references: c14.references %>
        <% actions = render("application/actions", i: c14) if can_manage %>
        <tr>
          <% if show_site %>
            <td class="d-none d-md-table-cell"><%= site_link %></td>
          <% end %>
          <td>
            <%= link_to c14.lab_identifier, c14, target: :_top %>
            <div class="d-md-none">
              <% if show_site %>
                <div><%= site_link %></div>
              <% end %>
              <div class="small text-body-secondary mt-1">
                <div>Context: <%= context_name %></div>
                <div>Material: <%= material %></div>
                <div>Taxon: <%= taxon %></div>
                <div>Method: <%= method %></div>
                <div>References: <%= references %></div>
              </div>
              <% if can_manage %>
                <div class="mt-2"><%= actions %></div>
              <% end %>
            </div>
          </td>
          <td class="d-none d-md-table-cell"><%= context_name %></td>
          <td class="d-none d-md-table-cell"><%= material %></td>
          <td class="d-none d-md-table-cell"><%= taxon %></td>
          <td class="d-none d-md-table-cell"><%= method %></td>
          <td class="text-md-end">
            <div class="d-md-none">
              <div class="small text-body-secondary">Uncalibrated</div>
              <%= uncalibrated_age %>
              <div class="small text-body-secondary mt-1">Calibrated</div>
              <%= calibrated_age %>
            </div>
            <span class="d-none d-md-inline font-monospace"><%= uncalibrated_age %></span>
          </td>
          <td class="d-none d-md-table-cell text-end font-monospace"><%= calibrated_age %></td>
          <td class="d-none d-md-table-cell text-end small"><%= references %></td>
          <% if can_manage %>
            <td class="d-none d-md-table-cell text-end"><%= actions %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
